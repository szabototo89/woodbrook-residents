{
  "name": "sanity-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "dev": "sanity dev",
    "start": "sanity start",
    "test:unit": "vitest run --coverage",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:e2e": "bun run build && playwright test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/vision": "^6.16.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sanity": "^6.16.0",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sanity/eslint-config-studio": "^7",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.14",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^10.8.1",
    "playwright": "1.63.0",
    "prettier": "^3.5",
    "typescript": "^5.8",
    "vite": "^8.0.0",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  },
  "prettier": {
    "bracketSpacing": false,
    "printWidth": 100,
    "semi": false,
    "singleQuote": true
  }
}
