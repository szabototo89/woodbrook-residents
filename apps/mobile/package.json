{
  "name": "mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run build:all",
    "build:all": "bun run build:ios && bun run build:web",
    "build:ios": "rspeedy build --environment lynx",
    "build:web": "bun run build:web:bundle && bun run build:web:host",
    "build:web:bundle": "rspeedy build --environment web",
    "build:web:host": "MOBILE_WEB_COPY_BUNDLE=true rsbuild build --config rsbuild.web.config.ts",
    "dev": "bun run dev:all",
    "dev:all": "concurrently --kill-others --names bundles,web --prefix-colors cyan,magenta \"rspeedy dev\" \"bun run dev:web:host\"",
    "dev:ios": "rspeedy dev --environment lynx",
    "dev:web": "concurrently --kill-others --names bundle,web --prefix-colors cyan,magenta \"rspeedy dev --environment web\" \"bun run dev:web:host\"",
    "dev:web:host": "rsbuild dev --config rsbuild.web.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "bun run preview:web",
    "preview:ios": "rspeedy preview",
    "preview:web": "rsbuild preview --config rsbuild.web.config.ts",
    "test": "bun run test:unit && bun run test:web",
    "test:unit": "vitest run --coverage",
    "test:web": "WOODBROOK_API_URL=http://127.0.0.1:4317 bun run build:all && playwright test --config playwright.web.config.ts",
    "test:web:install": "playwright install chromium webkit",
    "typecheck": "tsc --build --pretty false && tsc --noEmit --pretty false --project tsconfig.browser.json"
  },
  "dependencies": {
    "@lynx-js/lynx-core": "0.1.4",
    "@lynx-js/react": "^0.126.1",
    "@lynx-js/web-core": "0.26.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@lynx-js/preact-devtools": "^5.0.1-20260827072047-5f77e12",
    "@lynx-js/qrcode-rsbuild-plugin": "^0.7.2",
    "@lynx-js/react-rsbuild-plugin": "^0.20.2",
    "@lynx-js/rspeedy": "^0.17.2",
    "@lynx-js/types": "^4.1.0",
    "@playwright/test": "1.63.0",
    "@rsbuild/core": "2.2.4",
    "@rsbuild/plugin-type-check": "^1.6.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "4.1.11",
    "concurrently": "^9.2.1",
    "jsdom": "^27.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
