{
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@lynx-js/react",
    "types": ["@lynx-js/rspeedy/client"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "skipLibCheck": true,
    "target": "ES2022"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "lynx.config.ts",
    "vitest.config.ts",
    "../web/src/features/content/googleSheetsParsing.ts",
    "../web/src/features/content/contentTaxonomy.ts",
    "../web/src/features/content/contentTypes.ts",
    "../web/src/features/content/contentSource.ts",
    "../web/src/features/content/contentSchemas.ts"
  ]
}
