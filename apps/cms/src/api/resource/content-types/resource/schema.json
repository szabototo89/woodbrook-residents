{
  "kind": "collectionType",
  "collectionName": "resources",
  "info": {
    "singularName": "resource",
    "pluralName": "resources",
    "displayName": "Resource",
    "description": "Curated local contacts, services, and useful links"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "health",
        "trades",
        "professional",
        "care",
        "transport",
        "council",
        "community",
        "safety",
        "waste",
        "recreation",
        "education",
        "childcare",
        "other"
      ],
      "required": true
    },
    "serviceType": {
      "type": "string",
      "required": true
    },
    "providerType": {
      "type": "enumeration",
      "enum": ["business", "public-service", "community", "nonprofit", "other"],
      "required": true,
      "default": "business"
    },
    "description": {
      "type": "text",
      "required": true
    },
    "url": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "email"
    },
    "outOfHours": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "details": {
      "type": "component",
      "component": "shared.resource-detail",
      "repeatable": true
    },
    "collectionDates": {
      "type": "component",
      "component": "shared.collection-date",
      "repeatable": true
    },
    "documentUrl": {
      "type": "string"
    },
    "documentLabel": {
      "type": "string"
    },
    "displayOrder": {
      "type": "integer",
      "required": true,
      "default": 0
    },
    "sourceReviewedOn": {
      "type": "date",
      "required": true
    },
    "sourceName": {
      "type": "string",
      "required": true
    },
    "sourceUrl": {
      "type": "string",
      "required": true
    }
  }
}
