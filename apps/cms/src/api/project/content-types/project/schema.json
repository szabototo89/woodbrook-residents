{
  "kind": "collectionType",
  "collectionName": "projects",
  "info": {
    "singularName": "project",
    "pluralName": "projects",
    "displayName": "Project",
    "description": "Neighbourhood projects and initiatives tracked over time"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "transport",
        "housing",
        "parks",
        "public-realm",
        "planning",
        "community",
        "environment",
        "safety",
        "education",
        "other"
      ],
      "required": true
    },
    "stage": {
      "type": "enumeration",
      "enum": [
        "proposed",
        "active",
        "monitoring",
        "paused",
        "completed",
        "consultation"
      ],
      "required": true,
      "default": "monitoring"
    },
    "summary": {
      "type": "text",
      "required": true
    },
    "details": {
      "type": "richtext",
      "required": true
    },
    "updatedOn": {
      "type": "date",
      "required": true
    },
    "nextStep": {
      "type": "string"
    },
    "sourceName": {
      "type": "string",
      "required": true
    },
    "sourceUrl": {
      "type": "string",
      "required": true
    },
    "sourceReviewedOn": {
      "type": "date",
      "required": true
    },
    "imagePath": {
      "type": "string"
    },
    "imageAlt": {
      "type": "string"
    },
    "imageCredit": {
      "type": "string"
    },
    "imageCreditUrl": {
      "type": "string"
    },
    "featured": {
      "type": "boolean",
      "default": false
    }
  }
}
