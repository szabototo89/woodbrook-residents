{
  "kind": "collectionType",
  "collectionName": "updates",
  "info": {
    "singularName": "update",
    "pluralName": "updates",
    "displayName": "Update",
    "description": "News, notices, transport updates, and planning explainers"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "kind": {
      "type": "enumeration",
      "enum": ["news", "planning", "transport", "community"],
      "required": true,
      "default": "news"
    },
    "summary": {
      "type": "text",
      "required": true
    },
    "body": {
      "type": "richtext",
      "required": true
    },
    "publishedOn": {
      "type": "date",
      "required": true
    },
    "sourceName": {
      "type": "string",
      "required": true
    },
    "sourceUrl": {
      "type": "string",
      "required": true
    },
    "sourceReviewedOn": {
      "type": "date",
      "required": true
    },
    "imagePath": {
      "type": "string"
    },
    "imageAlt": {
      "type": "string"
    },
    "imageCredit": {
      "type": "string"
    },
    "imageCreditUrl": {
      "type": "string"
    },
    "featured": {
      "type": "boolean",
      "default": false
    }
  }
}
