{
  "name": "laura-faichney-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/generate-content.ts development && vite dev --port 3003",
    "build": "bun run content:generate && vite build",
    "build:static": "bun scripts/build-static.ts",
    "deploy": "bun ../../scripts/deploy-laura.ts",
    "preview": "vite preview",
    "test:e2e": "bun run build:e2e && playwright test",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:static": "bun scripts/verify-static-build.ts",
    "content:generate": "bun scripts/generate-content.ts",
    "build:e2e": "bun --preload ./tests/fixtures/gallery-fetch.mjs scripts/generate-content.ts && vite build"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@sanity/client": "^6.29.0",
    "@sanity/image-url": "^1.2.0",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.48.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.10"
  }
}
