{
  "name": "dashboard",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3001",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview --port 4174",
    "test:unit": "vitest run --coverage src --exclude 'src/**/*.browser.test.tsx'",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:e2e": "bun run build && playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.6.0",
    "@astryxdesign/theme-butter": "^0.6.0",
    "@astryxdesign/theme-neutral": "^0.6.0",
    "@stylexjs/stylex": "^0.19.0",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "lucide-react": "^0.544.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.6.0",
    "@playwright/test": "1.63.0",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "4.1.11",
    "happy-dom": "^20.14.5",
    "playwright": "1.63.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  }
}
