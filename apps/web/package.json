{
  "name": "web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:sheets": "CONTENT_SOURCE=google-sheets vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "build:static": "bun scripts/build-static.ts",
    "check:search-console": "bun scripts/check-search-console.ts",
    "check:pagespeed": "bun scripts/check-pagespeed.ts",
    "preview": "vite preview",
    "test:unit": "vitest run --coverage src --exclude 'src/**/*.browser.test.tsx' --exclude 'src/**/*.static.test.tsx' && vitest run --mode static src/features/search/SearchPage.static.test.tsx",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:e2e": "VITE_FIREBASE_API_KEY= VITE_FIREBASE_AUTH_ENABLED=false VITE_PUBLIC_SITE_URL=https://woodbrook.shankill.workers.dev bun run build && playwright test && bun run test:auth",
    "test:lighthouse": "bun scripts/lighthouse.ts",
    "typecheck": "tsc --noEmit",
    "verify:static": "bun scripts/verify-static-build.ts",
    "test:auth": "playwright test --config playwright.firebase.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@sanity/client": "^8.7.0",
    "@sanity/image-url": "^2.1.1",
    "@tanstack/react-router": "1.170.39",
    "@tanstack/react-start": "1.168.58",
    "@tanstack/start-static-server-functions": "^1.167.34",
    "add-to-calendar-button": "^3.1.2",
    "firebase": "^13.1.0",
    "google-auth-library": "^11.0.2",
    "lucide-react": "^0.544.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "4.1.11",
    "happy-dom": "^20.14.5",
    "lighthouse": "^13.4.1",
    "playwright": "1.63.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
