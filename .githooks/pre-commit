#!/bin/sh

set -eu

cd "$(git rev-parse --show-toplevel)"
# Auto-format staged files so commits never fail on formatting.
staged_prettier="$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx|js|jsx|mjs|cjs|json|css|md)$' || true)"
if [ -n "$staged_prettier" ]; then
  printf '%s\n' "$staged_prettier" | xargs bunx prettier --write
  printf '%s\n' "$staged_prettier" | xargs git add
fi
# Auto-format design-proposals only; never touches web/cms/dashboard/mobile.
if git diff --cached --name-only | grep -q "^apps/design-proposals/"; then
  bun run --cwd apps/design-proposals format
  git add apps/design-proposals
fi
exec bun run precommit
