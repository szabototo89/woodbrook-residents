{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "shell",
      "resource": "*--no-verify*",
      "effect": "deny"
    }
  ],
  "mcp": {
    "clarity": {
      "type": "local",
      "command": ["npx", "-y", "@microsoft/clarity-mcp-server"],
      "environment": {
        "CLARITY_API_TOKEN": "{env:CLARITY_API_TOKEN}"
      },
      "enabled": true
    },
    "lynx-devtool": {
      "type": "local",
      "command": ["npx", "-y", "@lynx-js/devtool-mcp-server@latest"],
      "enabled": true
    }
  }
}
