{
  "name": "woodbrook-community-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "prepare": "bun run hooks:install",
    "hooks:install": "git config core.hooksPath .githooks",
    "precommit": "bun run lint && bun run test",
    "dev": "CONTENT_SOURCE=sanity bun scripts/app.ts dev web --env-file=../../.env",
    "dev:web": "CONTENT_SOURCE=sanity bun scripts/app.ts dev web --env-file=../../.env",
    "dev:web:sheets": "CONTENT_SOURCE=google-sheets bun scripts/app.ts dev:sheets web --env-file=../../.env",
    "dev:web:sanity": "CONTENT_SOURCE=sanity bun scripts/app.ts dev web --env-file=../../.env",
    "dev:web:content": "CONTENT_SOURCE=sanity bun scripts/app.ts dev web --env-file=../../.env",
    "dev:dashboard": "bun scripts/app.ts dev dashboard",
    "dev:mobile": "bun scripts/app.ts dev mobile --env-file=../../.env",
    "dev:mobile:ios": "bun scripts/app.ts dev:ios mobile",
    "dev:mobile:web": "bun scripts/app.ts dev:web mobile",
    "dev:laura-faichney-web": "bun scripts/app.ts dev laura-faichney-web",
    "dev:sanity-studio": "bun scripts/app.ts dev sanity-studio",
    "dev:laura-studio": "bun scripts/app.ts dev laura-studio",
    "dev:design-proposal": "bun scripts/app.ts dev design-proposal",
    "dev:design-proposals": "bun scripts/app.ts dev design-proposals",
    "build": "bun scripts/app.ts build",
    "build:web": "bun scripts/app.ts build web",
    "build:dashboard": "bun scripts/app.ts build dashboard",
    "build:mobile": "bun scripts/app.ts build mobile",
    "build:laura-faichney-web": "bun scripts/app.ts build laura-faichney-web",
    "build:sanity-studio": "bun scripts/app.ts build sanity-studio",
    "build:laura-studio": "bun scripts/app.ts build laura-studio",
    "build:design-proposal": "bun scripts/app.ts build design-proposal",
    "build:static": "bun scripts/app.ts build:static web --env-file=../../.env",
    "deploy": "bun scripts/deploy.ts",
    "deploy:laura": "bun scripts/deploy-laura.ts",
    "worktree:remove": "scripts/worktree-remove.sh",
    "worktree:list-old": "bun scripts/list-old-worktrees.ts",
    "worktree:clean-old": "bun scripts/list-old-worktrees.ts --clean",
    "worktree:clean-stale": "bun scripts/list-old-worktrees.ts --clean --stale-only",
    "preinstall": "bun scripts/list-old-worktrees.ts --days 7 || true",
    "test:scripts": "bun test scripts/deploy-forma.test.ts scripts/deploy.test.ts scripts/app.test.ts scripts/list-old-worktrees.test.ts scripts/eslint-laura-offline-tests.test.ts scripts/eslint-named-props-rule.test.ts",
    "test": "bun run test:scripts && bun run test:unit && bun run test:browser && bun run test:e2e",
    "test:install-browser": "bun run --cwd apps/web playwright install chromium webkit",
    "test:unit": "bun scripts/app.ts test:unit",
    "test:browser": "bun scripts/app.ts test:browser",
    "test:e2e": "bun scripts/app.ts test:e2e",
    "test:lighthouse": "bun scripts/app.ts test:lighthouse web",
    "test:lighthouse:laura": "bun scripts/app.ts test:lighthouse laura-faichney-web",
    "typecheck": "bun scripts/app.ts typecheck && bun run typecheck:scripts",
    "typecheck:scripts": "tsc --noEmit --module esnext --moduleResolution bundler --target es2022 --strict --noImplicitAny --noImplicitOverride --noImplicitReturns --noUncheckedIndexedAccess --skipLibCheck --types bun scripts/app.ts scripts/app.test.ts scripts/list-old-worktrees.ts scripts/list-old-worktrees.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "bun run format:check && eslint \"apps/*/src/**\" \"apps/*/tests/**\" \"apps/sanity-studio/schemaTypes/**\" \"apps/sanity-studio/components/**\" \"apps/sanity-studio/*.ts\" \"apps/laura-studio/schemaTypes/**\" \"apps/laura-studio/*.ts\" scripts && bun run typecheck",
    "dev:handoffs": "bun scripts/app.ts dev handoffs",
    "build:handoffs": "bun scripts/app.ts build handoffs",
    "test:firestore": "firebase emulators:exec --only firestore --project demo-woodbrook-profiles \"bun test apps/web/tests/firestore/firestore.rules.test.ts\""
  },
  "dependencies": {
    "google-auth-library": "^11.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/bun": "^1.2.22",
    "concurrently": "^9.2.1",
    "eslint": "^10.0.0",
    "eslint-plugin-react": "^7.37.5",
    "firebase-tools": "^15.34.1",
    "prettier": "^3.8.2",
    "typescript": "^5",
    "typescript-eslint": "^8.67.0",
    "wrangler": "^4.130.0"
  }
}
