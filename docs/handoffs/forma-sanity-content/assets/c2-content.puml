Person(forma_maintainer, "Forma maintainer", "Rebuilds and deploys the published website")
System_Ext(forma_cms, "[ADDED] Forma Sanity project", "Stores Forma published content, drafts and images\nChange: Stores migrated Forma documents and images.")
System_Ext(forma_ci, "GitHub Actions", "Runs the Forma build and deploy workflow on main")
System_Ext(forma_pages, "Cloudflare Pages", "Hosts the successfully built static Forma website")
System_Boundary(forma_system, "Forma Studio website") {
  Container(forma_web, "[CHANGED] Forma public site", "React and prerendered HTML", "Displays the two static pages and opens email enquiries\nChange: Copy, metadata and image URLs come from the validated snapshot.")
  Container(forma_studio, "[ADDED] Forma content editor", "Sanity Studio SPA", "Edits and publishes Forma content with field guidance\nChange: New dedicated editor with contextual help on every field.")
  Container(forma_builder, "[CHANGED] Forma static builder", "Bun, Vite and TanStack Start", "Validates content and builds both public pages\nChange: Requires fresh Sanity content to pass Zod before prerendering.")
