Rel(forma_customer, forma_web, "Browses static pages using", "Browser")
Rel(forma_editor, forma_studio, "[ADDED] Edits content using\nChange: Introduces no-code content editing.", "Browser")
Rel(forma_studio, forma_cms, "[ADDED] Saves drafts and publishes\nChange: Writes only to the dedicated Forma project.", "Sanity API / HTTPS")
Rel(forma_builder, forma_cms, "[ADDED] Reads published content\nChange: Published-only reads replace TypeScript content imports.", "GROQ / HTTPS")
Rel(forma_builder, forma_web, "[CHANGED] Builds the public pages\nChange: Embeds validated CMS content rather than local copy.", "Vite virtual module and HTML")
Rel(forma_web, forma_cms, "[ADDED] Loads published image assets\nChange: Loads the migrated images from Sanity CDN.", "Sanity CDN / HTTPS")
Rel(forma_maintainer, forma_ci, "Starts a rebuild after publishing", "workflow_dispatch")
Rel(forma_ci, forma_builder, "Runs content validation and static build", "Bun CLI")
Rel(forma_ci, forma_pages, "Uploads successful static output", "Wrangler / HTTPS")
