  Component(laura_images, "Image cache", "Bun filesystem cache", "Downloads responsive variants of usable site images")
  Component(laura_pages, "[CHANGED] Page components", "React", "Render available content and omit absent sections and artwork\nChange: Adds category price lists with fixed/from/range/quote modes and enquiry URLs.")
}

Rel(laura_prices_snapshot, laura_reader, "[ADDED] Captures validated published page content using\nChange: Captures Prices with the other pages; fresh read failures abort the build.", "TypeScript")
Rel(laura_reader, laura_sanity, "[CHANGED] Queries published page content\nChange: Adds the published Prices query and dereferences category enquiry services.", "GROQ over HTTPS")
Rel(laura_prices_snapshot, laura_images, "Caches usable page images using", "TypeScript")
Rel(laura_pages, laura_prices_snapshot, "[ADDED] Renders build-time content using\nChange: Reuses the Prices snapshot for generated HTML and browser navigation.", "virtual:laura-content")
