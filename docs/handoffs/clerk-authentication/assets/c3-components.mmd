C4Component
  title Clerk accounts - web components
  Container_Boundary(web, "apps/web") {
    Component(flags, "AuthProvider and authConfig", "React and TypeScript", "Checks environment or query opt-in and validates the publishable key")
    Component(runtime, "ClerkRuntime", "Lazy ClerkProvider", "Loads Clerk only for enabled, configured visitors")
    Component(pages, "AuthPage and ClerkForms", "React", "Login, registration, setup messages and account-page links")
    Component(header, "AccountLinks and ClerkAccount", "React", "Login navigation or Clerk profile and sign-out menu")
    Component(recovery, "ForgotPasswordForm", "React and Clerk useSignIn", "Email reset codes, password confirmation and session completion")
  }
  Rel(flags, runtime, "Loads conditionally")
  Rel(runtime, pages, "Provides session context")
  Rel(runtime, header, "Provides account context")
  Rel(pages, recovery, "Renders dedicated recovery flow")
