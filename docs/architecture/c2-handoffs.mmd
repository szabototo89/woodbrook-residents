C4Container
  title Agent handoffs - containers
  Person(agent, "Engineering agent", "Reads and maintains handoffs")
  System_Boundary(handoffs, "Standalone handoff tooling") {
    Container(reader, "Handoff viewer", "React and Mermaid", "Displays MDX and C4 diagrams")
    Container(server, "Static file server", "Vite or any static server", "Serves the independent built viewer")
    ContainerDb(documents, "Repository documents", "MDX and Mermaid files", "Stores handoffs, evidence and C4 sources")
  }
  Rel(agent, reader, "Reads", "Browser")
  Rel(reader, server, "Requests", "HTTP")
  Rel(documents, server, "Compiled at build")
  UpdateRelStyle(reader, server, $offsetY="-40")
  UpdateRelStyle(documents, server, $offsetY="-30")
